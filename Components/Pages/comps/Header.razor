<header class="header-container">
	<div class="header">
		<div class="header-title">
			<div class="header-name">
				<h1 class="leading-none font-bold">Gabriel Sabella</h1>
				<h2 class="font-semibold">Full Stack Developer</h2>
			</div>
				<img src="/img/happy.jpg" alt="Gabriel Sabella" class="avatar-photo" />
		</div>

		<nav class="menu mt-4" aria-label="Page sections">
			<ul class="flex flex-col">
				@foreach (var section in Sections.All)
				{
				<li>
					<a href="#@section.Id" id="nav-@section.Id">@section.Label</a>
				</li>
				}
			</ul>
		</nav>
	</div>
</header>