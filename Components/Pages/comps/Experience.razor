<section id="@Sections.Experience.Id" class="experience">
    @foreach (var job in PortfolioData.Jobs)
    {
        <HoverCard>
            <div class="exp-item flex py-4">
                <div class="exp-time min-w-48 text-base font-mono">@job.Period</div>
                <div class="exp-info">
                    <h3 class="title text-2xl font-bold text-left pb-4">@job.Title</h3>
                    <p class="desc leading-6 pt-4">@job.Description</p>
                    <TechTags Items="job.Tech" />
                </div>
            </div>
        </HoverCard>
    }

    <a href="/Gabriel_Sabella_Resume_2026.pdf" class="btn btn-accent mt-16 font-mono"
       target="_blank" rel="noopener">View Complete CV</a>
</section>