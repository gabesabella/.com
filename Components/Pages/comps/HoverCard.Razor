<div class="exp-item-wrapper relative mt-16">
    <div class="expand"></div>
    @if (Href is not null)
    {
        <a href="@Href" class="link" target="_blank" rel="noopener" aria-label="@Label"></a>
    }
    @ChildContent
</div>

@code {
    [Parameter] public string? Href { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}