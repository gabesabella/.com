@inject IJSRuntime JS

<div class="wrapper">
    <div class="main-layout">
        <Header />
        <main class="main-content">
            <Intro />
            <SectionTitle Title="@Sections.Experience.Label" />
            <Experience />
            <SectionTitle Title="@Sections.Projects.Label" />
            <Projects />
            <SectionTitle Title="@Sections.Contact.Label" />
            <Contact />
            <SectionTitle />

            <BuiltWith />
        </main>
    </div>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var ids = Sections.All.Select(s => s.Id).ToArray();
            await JS.InvokeVoidAsync("observeSections", ids);
            await JS.InvokeVoidAsync("followSection", ".header", ".contact-lead");
        }
    }
}